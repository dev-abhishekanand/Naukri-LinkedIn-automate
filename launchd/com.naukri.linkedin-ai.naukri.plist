<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.naukri.linkedin-ai.naukri</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/abhishekanand/naukri-linkedin-ai/scripts/run_naukri_scheduled.sh</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/abhishekanand/Library/Logs/naukri_launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/abhishekanand/Library/Logs/naukri_launchd.stderr.log</string>

    <!-- Run every day (Monday to Sunday) at 09:00 AM IST -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
